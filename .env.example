# apps/mobile/.env  (copy to apps/mobile/.env — Expo reads EXPO_PUBLIC_* at build time)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# RevenueCat public SDK keys (dashboard → Project → API keys). Public, not secret.
# Without them the paywall shows "Disponible pronto" (purchases unavailable).
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_...

# Supabase Edge Function secrets — set with the CLI, NOT in this file:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set OPENAI_API_KEY=sk-...
#   supabase secrets set REVENUECAT_WEBHOOK_SECRET=...   # openssl rand -hex 32; RC dashboard webhook sends it as "Bearer <value>"
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into edge functions automatically.)
